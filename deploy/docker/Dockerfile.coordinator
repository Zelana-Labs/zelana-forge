# Dockerfile for prover-coordinator
FROM rust:1.87 as builder

WORKDIR /app

# Copy workspace files
COPY /Cargo.toml ./Cargo.toml
COPY /prover-core ./prover-core
COPY /prover-network ./prover-network
COPY /prover-node ./prover-node
COPY /prover-coordinator ./prover-coordinator

# Build the coordinator binary
RUN cargo build --release -p prover-coordinator

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/prover-coordinator /usr/local/bin/prover-coordinator

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/prover-coordinator"]
